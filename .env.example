# LLM providers
GROQ_API_KEY=
GROQ_MODEL=groq/compound-mini
GROQ_INTENT_MODEL=qwen/qwen3.6-27b
INTENT_CLASSIFIER_PROVIDER=groq
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
LLM_PRIMARY_PROVIDER=groq

# Research search
TAVILY_API_KEY=
TAVILY_CACHE_TTL_SECONDS=600

# Optional Gemini provider and embeddings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Local embeddings and Chroma persistence
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_BACKEND=sentence-transformers
CHROMA_PERSIST_DIR=./chroma_data
ROUTER_TOP_K=6

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agents-ai-semantic-router
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
