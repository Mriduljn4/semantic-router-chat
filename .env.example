# Free Groq API key: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Free Gemini API key: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Set to gemini to use Gemini before Groq (used by the free Render deployment).
LLM_PRIMARY_PROVIDER=groq

# Local embedding model and Chroma persistence
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
CHROMA_PERSIST_DIR=./chroma_data
ROUTER_TOP_K=6

# Optional LangSmith tracing: https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agents-ai-semantic-router
